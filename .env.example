# Copiez ce fichier en .env
# Obtenez api_id et api_hash sur https://my.telegram.org
# Générez la SESSION_STRING avec : python generate_session.py

# Compte 1
ACCOUNT_1_API_ID=12345678
ACCOUNT_1_API_HASH=abcdef1234567890abcdef1234567890
ACCOUNT_1_SESSION=1BVtsOKABu...  # sortie de generate_session.py

# Compte 2 (optionnel)
ACCOUNT_2_API_ID=
ACCOUNT_2_API_HASH=
ACCOUNT_2_SESSION=

# Compte 3 (optionnel)
ACCOUNT_3_API_ID=
ACCOUNT_3_API_HASH=
ACCOUNT_3_SESSION=

# Paramètres anti-ban
MIN_DELAY=2
MAX_DELAY=6
MAX_MEMBERS_PER_GROUP=500
MAX_DEPTH=3
REQUESTS_BEFORE_PAUSE=30
LONG_PAUSE_MIN=60
LONG_PAUSE_MAX=180

FLASK_SECRET_KEY=changeme_secret_key_here
