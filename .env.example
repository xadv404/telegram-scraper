# Copiez ce fichier en .env et remplissez vos valeurs
# Obtenez api_id et api_hash sur https://my.telegram.org

# Compte 1
ACCOUNT_1_API_ID=12345678
ACCOUNT_1_API_HASH=abcdef1234567890abcdef1234567890
ACCOUNT_1_PHONE=+33612345678

# Compte 2 (optionnel, pour la rotation)
ACCOUNT_2_API_ID=
ACCOUNT_2_API_HASH=
ACCOUNT_2_PHONE=

# Compte 3 (optionnel)
ACCOUNT_3_API_ID=
ACCOUNT_3_API_HASH=
ACCOUNT_3_PHONE=

# Paramètres anti-ban
MIN_DELAY=2        # délai minimum entre requêtes (secondes)
MAX_DELAY=6        # délai maximum entre requêtes (secondes)
MAX_MEMBERS_PER_GROUP=500   # limite membres scrappés par groupe
MAX_DEPTH=3        # profondeur de récursion max
REQUESTS_BEFORE_PAUSE=30   # requêtes avant une pause longue
LONG_PAUSE_MIN=60           # pause longue min (secondes)
LONG_PAUSE_MAX=180          # pause longue max (secondes)

FLASK_SECRET_KEY=changeme_secret_key_here
